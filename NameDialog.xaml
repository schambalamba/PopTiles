<Window x:Class="TaskbarGruppen.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.NewGroup}" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="16">
    <TextBlock Text="{DynamicResource L.GroupName}" Margin="2,0,0,6" />
    <TextBox x:Name="NameBox" AutomationProperties.Name="{DynamicResource L.GroupName}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="{DynamicResource L.Create}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" IsDefault="True" Click="Create_Click" />
      <Button Content="{DynamicResource L.Cancel}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
