<Window x:Class="TaskbarGruppen.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.AddApp}" Width="460" Height="600" MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <DockPanel Margin="16">
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,10" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="{DynamicResource L.Cancel}" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="{DynamicResource L.Add}" Style="{StaticResource PrimaryButton}" Margin="6,0,6,0" IsDefault="True" Click="Add_Click" />
      <TextBlock Text="{DynamicResource L.SelectSeveral}" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="4">
      <ListBox x:Name="AppList" SelectionMode="Extended" MouseDoubleClick="AppList_MouseDoubleClick"
               VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
