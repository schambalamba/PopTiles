<Window x:Class="TaskbarGruppen.TileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.AppName}"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        Background="Transparent" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1"
                  UseAeroCaptionButtons="False" CornerRadius="0" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="TileButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}" />
      <Setter Property="Width" Value="92" />
      <Setter Property="Height" Value="100" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Hover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Pressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GearButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="ListRowButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
      <Setter Property="Width" Value="250" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="2,1" />
    </Style>

    <DataTemplate x:Key="ListRowTemplate">
      <Button Style="{StaticResource ListRowButton}" Click="Item_Click" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
        <DockPanel Margin="8,0">
          <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant" />
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{DynamicResource TileTint}" Padding="10,8,10,10" MinWidth="190">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="6,0,0,4">
        <Button DockPanel.Dock="Right" Style="{StaticResource GearButton}" ToolTip="{DynamicResource L.EditGroup}" Click="Edit_Click">
          <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                     Foreground="{DynamicResource FgDim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
        <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Fg}"
                   HorizontalAlignment="Left" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />
      </DockPanel>

      <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Visibility="Collapsed" Margin="6,8,6,8"
                 Foreground="{DynamicResource FgDim}" Text="{DynamicResource L.TileEmpty}" TextWrapping="Wrap" MaxWidth="230" />

      <ItemsControl x:Name="ItemsList" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource TileButton}" Click="Item_Click" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
              <StackPanel Margin="4,8,4,4">
                <Image Source="{Binding Icon}" Width="40" Height="40" RenderOptions.BitmapScalingMode="Fant" />
                <TextBlock Text="{Binding Title}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="34" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DockPanel>
  </Border>
</Window>
