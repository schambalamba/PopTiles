<Window x:Class="TaskbarGruppen.IconPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.ChooseIcon}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <StackPanel Margin="16">
    <DockPanel Margin="0,0,0,14">
      <Image x:Name="Preview" Width="64" Height="64" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="Fant" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="NameText" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
        <Button Content="{DynamicResource L.AutomaticIcon}" Margin="0,6,0,0" HorizontalAlignment="Left" Click="Auto_Click" />
      </StackPanel>
    </DockPanel>

    <TextBlock Text="{DynamicResource L.Symbol}" FontWeight="SemiBold" Margin="0,0,0,6" />
    <ItemsControl x:Name="SymbolList" KeyboardNavigation.TabNavigation="Local">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="9" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Height="44" Margin="2" Padding="0" Click="Symbol_Click" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
            <TextBlock Text="{Binding Text}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="{DynamicResource L.Color}" FontWeight="SemiBold" Margin="0,12,0,6" />
    <ItemsControl x:Name="ColorList">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Width="36" Height="28" Margin="2" Padding="0" Background="{Binding Brush}" Click="Color_Click"
                  ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <WrapPanel Margin="0,6,0,0">
      <Button Margin="2,0,12,0" Padding="9,5" Click="CustomColor_Click" AutomationProperties.Name="{DynamicResource L.CustomColor}">
        <StackPanel Orientation="Horizontal">
          <Border x:Name="CustomSwatch" Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource Line}" />
          <TextBlock Text="{DynamicResource L.CustomColor}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <CheckBox x:Name="TileColorBox" VerticalAlignment="Center" Foreground="{DynamicResource Fg}" Content="{DynamicResource L.TileColor}" />
    </WrapPanel>

    <StackPanel x:Name="EntrySection">
      <TextBlock Text="{DynamicResource L.ItemIcon}" FontWeight="SemiBold" Margin="0,12,0,6" />
      <ItemsControl x:Name="EntryList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Width="44" Height="44" Margin="2" Padding="0" Click="Entry_Click"
                    ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
              <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="Fant" />
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="{DynamicResource L.InstalledIcons}" Margin="0,0,6,0" Click="Gallery_Click" />
      <Button Content="{DynamicResource L.ChooseImage}" Click="Browse_Click" />
    </StackPanel>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="{DynamicResource L.Apply}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" IsDefault="True" Click="Apply_Click" />
      <Button Content="{DynamicResource L.Cancel}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
